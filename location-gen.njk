    "@type": "PostalAddress",
    "addressLocality": "{{ city.name }}",
    "addressRegion": "{{ city.stateAbbr }}",
    "addressCountry": "US"
  },
  "areaServed": {
    "@type": "City",
    "name": "{{ city.name }}",
