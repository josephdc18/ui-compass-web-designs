{
  "name": "exported-site",
  "version": "1.0.0",
  "description": "Static site exported from Page Builder",
  "scripts": {
    "start": "eleventy && wrangler pages dev public/",
    "build": "eleventy",
    "dev": "eleventy --watch & wrangler pages dev public/ --ip 0.0.0.0",
    "init": "node setup.js",
    "teardown": "node teardown.js",
    "build:content-kit": "node scripts/build-content-kit-bundle.mjs",
    "blog-card": "node scripts/screenshot-blog-card.mjs",
    "prebuild": "node scripts/build-content-kit-bundle.mjs",
    "predeploy": "node scripts/build-content-kit-bundle.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^1.0.2",
    "@11ty/eleventy-navigation": "^0.3.5",
    "gray-matter": "^4.0.3",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^2.0.1",
    "fflate": "^0.8.0",
    "jose": "^5.0.0",
    "luxon": "^3.4.4"
  }
}
