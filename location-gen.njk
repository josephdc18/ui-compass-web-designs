    "SEO",
    "Small Business Websites"{% if city.slug == 'san-antonio' %},
    "Bilingual Web Design",
    "Local SEO San Antonio"{% elif city.slug == 'frisco' %},
    "Local SEO Frisco",
    "Frisco Digital Marketing"{% elif city.slug == 'irving' %},
    "Local SEO Irving",
    "Irving Digital Marketing"{% elif city.slug == 'grand-prairie' %},
    "Local SEO Grand Prairie",
    "DFW Web Design"{% elif city.slug == 'mansfield' %},
    "Local SEO Mansfield",
    "DFW Web Design"{% elif city.slug == 'memphis' %},
    "Memphis Digital Marketing",
    "Local SEO Memphis"{% elif city.slug == 'nashville' %},
    "Local SEO Nashville",
    "Digital Marketing Nashville"{% elif city.slug == 'knoxville' %},
    "Local SEO Knoxville",
    "Digital Marketing Knoxville"{% elif city.slug == 'chattanooga' %},
    "Local SEO Chattanooga",
    "Gig City Web Design"{% elif city.slug == 'dallas' or city.slug == 'fort-worth' or city.slug == 'arlington' %},
    "DFW Web Design"{% endif %}
  ],
  "serviceType": ["Web Design", "Custom-Coded Websites", "Local SEO", "Landing Page Design", "Analytics & Tracking", "Website Speed Optimization"],
  "sameAs": [
    "https://www.facebook.com/profile.php?id=61555680039337",
    "https://www.instagram.com/uicompass/"
  ]
  {% if copy.faq %}
  ,"mainEntity": [
    {% for item in copy.faq %}
